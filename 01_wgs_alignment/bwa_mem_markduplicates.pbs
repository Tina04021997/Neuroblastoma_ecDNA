#!/bin/bash
#PBS -q <queue>
#PBS -A <account>
#PBS -l nodes=1:ppn=28
#PBS -l walltime=500:00:00
#PBS -V
#PBS -N WGS_align
#PBS -o logs/align.o
#PBS -e logs/align.e

# WGS alignment + duplicate marking for one cell line.
# Submit per sample:   qsub -v SAMPLE=CHP134 -N align_CHP134 bwa_mem_markduplicates.pbs
# BWA-MEM 0.7.17-r1188, SAMtools 1.9, Picard 2.18.27 (conda env evc_main).

set -euo pipefail
source "${PBS_O_WORKDIR:-$(dirname "${BASH_SOURCE[0]}")}/../config.sh"
SAMPLE="${SAMPLE:?usage: qsub -v SAMPLE=<id> $0}"

activate_env evc_main
require_file "${WGS_REF_FASTA}" \
             "${WGS_FASTQ_DIR}/${SAMPLE}_1.fastq.gz" "${WGS_FASTQ_DIR}/${SAMPLE}_2.fastq.gz"

echo "=== Starting alignment on sample ${SAMPLE} at $(date) ==="
mkdir -p "${WGS_ALIGN_DIR}/${SAMPLE}" "${TMP_DIR}"
cd "${WGS_ALIGN_DIR}/${SAMPLE}"
log_version "bwa 2>&1 | head -4; samtools --version | head -1; picard MarkDuplicates --version" "${SAMPLE}.versions.txt"

alignS=$SECONDS
bwa mem -T 0 -t "$(nproc)" -R "@RG\tID:${SAMPLE}\tSM:${SAMPLE}_tumor\tPL:ILLUMINA" \
    "${WGS_REF_FASTA}" "${WGS_FASTQ_DIR}/${SAMPLE}_1.fastq.gz" "${WGS_FASTQ_DIR}/${SAMPLE}_2.fastq.gz" \
  | samtools view -bh --input-fmt-option nthreads="$(nproc)" \
  | samtools sort -@ "$(nproc)" -o "${SAMPLE}_tumor_raw.bam"
echo "alignment took $(( (SECONDS - alignS) / 60 )) min"

mkdpS=$SECONDS
picard MarkDuplicates ASSUME_SORT_ORDER=coordinate MAX_FILE_HANDLES=4000 CREATE_INDEX=true \
    -Djava.io.tmpdir="${TMP_DIR}" -XX:ParallelGCThreads="$(nproc)" -Xmx4g VALIDATION_STRINGENCY=STRICT \
    I="${SAMPLE}_tumor_raw.bam" O="${SAMPLE}_tumor_mkdp.bam" M="${SAMPLE}_tumor_markDuplicates_Matrix.txt"
echo "markDuplicates took $(( (SECONDS - mkdpS) / 60 )) min"

require_file "${SAMPLE}_tumor_mkdp.bam" "${SAMPLE}_tumor_mkdp.bai"
echo "=== job ends at $(date) ==="
